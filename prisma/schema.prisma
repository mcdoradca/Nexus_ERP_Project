model AnalyticsQualitySnapshot {
  id                   String    @id @default(uuid())
  workspaceId          String
  platform             String    // 'ALLEGRO' | 'VONHALSKY' | 'BASELINKER'
  accountId            String    @default("default")
  snapshotDate         DateTime
  qualityScore         Float?
  maxQualityScore      Float?
  qualityGrade         String?
  openIssuesCount      Int       @default(0)
  returnsCount         Int       @default(0)
  claimsCount          Int       @default(0)
  negativeRatingsCount Int       @default(0)
  positiveRatingsCount Int       @default(0)
