generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique
  name                   String
  role                   String             @default("USER")
  color                  String
  isActive               Boolean            @default(true)
  createdAt              DateTime           @default(now())
  department             Department         @default(BRAK)
  group                  UserGroup          @default(PRACOWNICY)
  isOnline               Boolean            @default(false)
  lastSeen               DateTime           @default(now())
  passwordHash           String
  activeTaskId           String?
  accessibleModules      String[]           @default(["kanban", "campaigns", "projects", "products", "chat"])
  authoredAnnouncements  Announcement[]
  readAnnouncements      AnnouncementRead[]
  uploadedAssets         CampaignAsset[]
  assignedCampaigns      Campaign[]         @relation("CampaignAssignees")
  comments               Comment[]
  receivedDirectMessages DirectMessage[]    @relation("ReceivedDirectMessages")
  sentDirectMessages     DirectMessage[]    @relation("SentDirectMessages")
  globalMessages         GlobalMessage[]
  notifications          Notification[]
  ownedProjects          Project[]          @relation("ProjectOwner")
  managedProjects        Project[]          @relation("ProjectManager")
  blockingTasks          Task[]             @relation("TaskBlocker")
  createdTasks           Task[]             @relation("TaskCreator")
  ownedTasks             Task[]             @relation("TaskOwner")
  activeTask             Task?              @relation("ActiveWorker", fields: [activeTaskId], references: [id])
  assignedTasks          Task[]             @relation("TaskAssignees")
  uploadedInvoices       InvoiceDocument[]  @relation("UserInvoices")
  briaEventLogs          BriaEventLog[]
}

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  progress    Int       @default(0)
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  endDate     DateTime?
  startDate   DateTime?
  budget      Float     @default(0.0)
  ownerId     String?
  pmId        String?
  color       String    @default("bg-emerald-500")
  status      String    @default("AKTYWNY")
  comments    Comment[]
  owner       User?     @relation("ProjectOwner", fields: [ownerId], references: [id])
  pm          User?     @relation("ProjectManager", fields: [pmId], references: [id])
  tasks       Task[]
}

model Task {
  id               String       @id @default(uuid())
  taskId           String       @unique @default(dbgenerated("generate_task_id()"))
  title            String
  description      String?
  status           TaskStatus   @default(TODO)
  priority         TaskPriority @default(MEDIUM)
  dueDate          DateTime?
  projectId        String?
  creatorId        String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  startDate        DateTime?
  blockReason      String?
  campaignId       String?
  isBlocked        Boolean      @default(false)
  blockerId        String?
  estimatedHours   Float        @default(0.0)
  loggedHours      Float        @default(0.0)
  ownerId          String?
  parentTaskId     String?
  assignedGroups   String[]     @default([])
  isArchived       Boolean      @default(false)
  aiBottleneckRisk Float?       @default(0.0)
  comments         Comment[]
  blocker          User?        @relation("TaskBlocker", fields: [blockerId], references: [id])
  campaign         Campaign?    @relation(fields: [campaignId], references: [id])
  creator          User         @relation("TaskCreator", fields: [creatorId], references: [id])
  owner            User?        @relation("TaskOwner", fields: [ownerId], references: [id])
  parentTask       Task?        @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks         Task[]       @relation("SubTasks")
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activeWorkers    User[]       @relation("ActiveWorker")
  assignees        User[]       @relation("TaskAssignees")

  @@index([status])
  @@index([projectId])
  @@index([campaignId])
}

model Comment {
  id         String    @id @default(uuid())
  content    String
  actionType String    @default("message")
  taskId     String?
  authorId   String
  createdAt  DateTime  @default(now())
  fileName   String?
  fileUrl    String?
  campaignId String?
  projectId  String?
  author     User      @relation(fields: [authorId], references: [id])
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([projectId])
  @@index([campaignId])
}

model GlobalMessage {
  id         String   @id @default(uuid())
  content    String
  authorId   String
  createdAt  DateTime @default(now())
  actionType String   @default("message")
  fileName   String?
  fileUrl    String?
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

model Notification {
  id            String   @id @default(uuid())
  userId        String
  title         String
  message       String
  type          String   @default("info")
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  taskId        String?
  relatedTaskId String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model DirectMessage {
  id         String   @id @default(uuid())
  content    String
  isRead     Boolean  @default(false)
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())
  actionType String   @default("message")
  fileName   String?
  fileUrl    String?
  receiver   User     @relation("ReceivedDirectMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentDirectMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
}

model Announcement {
  id         String             @id @default(uuid())
  title      String
  content    String
  priority   String             @default("NORMAL")
  isRequired Boolean            @default(true)
  authorId   String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  author     User               @relation(fields: [authorId], references: [id])
  reads      AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  userId         String
  announcementId String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
}

model Campaign {
  id               String            @id @default(uuid())
  name             String
  description      String?
  instructions     String?           @default("")
  budget           Float             @default(0.0)
  networks         String?
  startDate        DateTime
  endDate          DateTime
  status           String            @default("Planowana")
  color            String            @default("bg-blue-500")
  assignees        User[]            @relation("CampaignAssignees")
  assignedGroups   String[]          @default([])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  budgetAgency     Float             @default(0.0)
  budgetMedia      Float             @default(0.0)
  budgetPOSM       Float             @default(0.0)
  productId        String?
  plannedCount     Int               @default(0)
  soldCount        Int               @default(0)
  brands           Brand[]
  contractors      Company[]
  product          Product?          @relation("CampaignPromotedProduct", fields: [productId], references: [id])
  assets           CampaignAsset[]
  campaignProducts CampaignProduct[]
  comments         Comment[]
  tasks            Task[]
  smiPosts         SmiPost[]
  dealsIRM         DealIRM[]         @relation("ZawieraDeal")
}

model Brand {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  campaigns Campaign[]
  products  Product[]
}

model CampaignProduct {
  id             String   @id @default(uuid())
  campaignId     String
  productId      String
  promoMechanic  String?
  posmAllocation Int      @default(0)
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([campaignId, productId])
}

model CampaignAsset {
  id         String   @id @default(uuid())
  campaignId String
  uploaderId String
  name       String
  fileUrl    String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  uploader   User     @relation(fields: [uploaderId], references: [id])
}

model InvoiceDocument {
  id         String   @id @default(uuid())
  fileName   String
  fileUrl    String
  uploaderId String
  uploadedAt DateTime @default(now())
  status     String   @default("PROCESSED")
  uploader   User     @relation("UserInvoices", fields: [uploaderId], references: [id])

  @@index([uploaderId])
}

model Product {
  id                    String            @id @default(uuid())
  ean                   String            @unique
  sku                   String            @unique
  name                  String
  stock                 Int               @default(0)
  salePrice             Float             @default(0.0)
  basePrice             Float             @default(0.0)
  inboundTransportCost  Float             @default(0.0)
  packagingCost         Float             @default(0.0)
  bdoEprCost            Float             @default(0.0)
  outboundTransportCost Float             @default(0.0)
  aiImageCost           Float             @default(0.0)
  targetMargin          Float             @default(0.20)
  proposedSalePrice     Float?
  status                String            @default("Aktywny")
  subiektId             String?           @unique
  baselinkerId          String?           @unique
  imageUrl              String?           @db.Text
  isSynced              Boolean           @default(false)
  brandId               String
  descriptionHtml       String?           @db.Text
  features              Json?
  images                String[]          @default([])
  weight                Float?
  length                Float?
  width                 Float?
  height                Float?
  taxRate               Float?
  videoUrl              String?
  attachments           Json?
  stockErpUnits         Int?
  stockWmsUnits         Int?
  baselinkerInventoryId Int?
  offerDraft            Json?             @default("{}")
  aeoContent            String?           @db.Text
  lastContentSource     String            @default("SYSTEM")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  campaignsAsMain       Campaign[]        @relation("CampaignPromotedProduct")
  campaignProducts      CampaignProduct[]
  bomElements           ProductBom[]      @relation("ProductBomElements")
  brand                 Brand             @relation(fields: [brandId], references: [id], onDelete: Cascade)
  dealsIRM              DealIRM[]         @relation("LokowanyProdukt")

  allegroCategory   MarketplaceCategory? @relation(fields: [allegroCategoryId], references: [id])
  allegroCategoryId String?

  leadTimeDays Int?
  riskScore    Float     @default(0.0)
  supplierId   String?
  supplier     Supplier? @relation("ProductSupplier", fields: [supplierId], references: [id])

  @@index([brandId])
  @@index([sku])
  @@index([ean])
  @@index([supplierId])
}

model EcoMaterial {
  id                String       @id @default(uuid())
  name              String       @unique
  ratePerKg         Float        @default(0.0)
  carbonFootprintKg Float?       @default(0.0)
  origin            String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  boms              ProductBom[]
}

model ProductBom {
  id          String      @id @default(uuid())
  productId   String
  materialId  String
  weightGrams Float
  product     Product     @relation("ProductBomElements", fields: [productId], references: [id], onDelete: Cascade)
  material    EcoMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([productId, materialId])
}

enum UserGroup {
  PRACOWNICY
  GOSC
  AGENCJE
}

enum Department {
  MARKETING
  BIURO
  MAGAZYN
  HANDLOWCY
  KAM
  PREZES
  ECOMMERCE
  SERWIS
  BRAK
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SmiPost {
  id           String   @id @default(uuid())
  campaignId   String
  brandLine    String?
  publishDate  DateTime
  postType     String?
  content      String?  @db.Text
  hashtags     String?  @db.Text
  hasGraphics  Boolean  @default(false)
  notes        String?  @db.Text
  redirectUrl  String?
  adBudgetInfo String?
  status       String   @default("Szkic")
  mediaUrls    String[] @default([])
  mediaTypes   String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model MarketplaceCategory {
  id         String    @id
  name       String
  parameters Json
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  products   Product[]
}

model Company {
  id        String   @id @default(uuid())
  taxId     String?  @unique // NIP
  regon     String?
  krs       String?
  name      String
  legalForm String? // np. "Sp. z o.o."
  industry  String?
  website   String?
  mainPhone String?
  mainEmail String?
  status    String   @default("Aktywny") // Aktywny, Zablokowany, Prospekt
  rating    Int?     @default(0) // 1-5 gwiazdek
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  CompanyBranch[]
  contacts  ContactPerson[]
  campaigns Campaign[]
}

model CompanyBranch {
  id             String   @id @default(uuid())
  companyId      String
  name           String // np. "Magazyn Główny", "Siedziba"
  type           String   @default("Oddział") // Siedziba, Magazyn, Sklep, Biuro
  street         String?
  building       String?
  city           String?
  postalCode     String?
  country        String   @default("Polska")
  isHeadquarters Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts ContactPerson[]

  @@index([companyId])
}

model ContactPerson {
  id        String   @id @default(uuid())
  companyId String
  branchId  String?
  firstName String
  lastName  String
  role      String? // Dyrektor, Księgowość, Handlowiec
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  CompanyBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([branchId])
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// INFLU-MATCH-ENTERPRISE-CRM MODELS
// ==========================================

model InfluencerProfile {
  id                   String   @id @default(uuid())
  name                 String
  handle               String   @unique
  platform             String   @default("INSTAGRAM")
  email                String?
  followers            Int      @default(0)
  engagementRate       Float    @default(0.0)
  authenticityScore    Float    @default(1.0)
  predictiveEngagement Float?   @default(0.0)
  vectorData           String[] @default([])
  demographicData      Json     @default("{}")
  gdprConsent          Boolean  @default(false)
  createdAt            DateTime @default(now())

  // --- POLA KOMERCYJNE (NANOOINFLU) ---
  preferredCollab String           @default("BARTER") // "BARTER", "PAID", "MIXED"
  minRate         Int              @default(0)
  maxRate         Int              @default(0)
  avatarUrl       String?
  socialUrl       String?
  deals           DealIRM[]        @relation("RealizujeDeal")
  notes           InfluencerNote[] @relation("PosiadaNotatki")
}

model InfluencerNote {
  id           String   @id @default(uuid())
  influencerId String
  content      String   @db.Text
  createdAt    DateTime @default(now())

  influencer InfluencerProfile @relation("PosiadaNotatki", fields: [influencerId], references: [id], onDelete: Cascade)
}

model DealIRM {
  id               String   @id @default(uuid())
  influencerId     String
  campaignId       String
  productId        String
  status           String   @default("NAWIAZANIE")
  proposedFee      Float    @default(0.0)
  isUokikCompliant Boolean  @default(false)
  uokikScanLog     String?  @db.Text
  calculatedEMV    Float    @default(0.0)
  outreachDraft    String?  @db.Text
  createdAt        DateTime @default(now())

  influencer InfluencerProfile @relation("RealizujeDeal", fields: [influencerId], references: [id], onDelete: Cascade)
  campaign   Campaign          @relation("ZawieraDeal", fields: [campaignId], references: [id], onDelete: Cascade)
  product    Product           @relation("LokowanyProdukt", fields: [productId], references: [id], onDelete: Cascade)

  logs ActionLog[] @relation("GenerujeLogi")

  @@unique([influencerId, campaignId, productId])
}

model ActionLog {
  id          String   @id @default(uuid())
  dealId      String
  actionType  String   @default("VIEW")
  description String?
  timestamp   DateTime @default(now())

  deal DealIRM @relation("GenerujeLogi", fields: [dealId], references: [id], onDelete: Cascade)
}

model BriaEventLog {
  id              String   @id @default(uuid())
  type            String // "EDIT_REMOVE_BG", "EDIT_GEN_FILL", "EDIT_ERASE", "ADS_GENERATE"
  status          String   @default("PENDING") // PENDING, COMPLETED, FAILED
  requestId       String?
  requestPayload  Json     @default("{}")
  responsePayload Json?
  resultUrl       String?
  editorIframeUrl String?
  templateId      String?
  brandId         String?
  userId          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// ==========================================
// ZERO-BLEED PIPELINE MODELS
// ==========================================

model Supplier {
  id           String    @id @default(uuid())
  name         String
  contactEmail String?
  contactPhone String?
  isActive     Boolean   @default(true)
  products     Product[] @relation("ProductSupplier")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CustomerRiskProfile {
  id             String    @id @default(uuid())
  allegroLogin   String    @unique
  maskedEmail    String?
  totalReturns   Int       @default(0)
  fraudScore     Float     @default(0.0)
  isBlacklisted  Boolean   @default(false)
  lastReturnDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  returnRecords ReturnRecord[]
}

model ReturnRecord {
  id            String   @id @default(uuid())
  baselinkerId  String   @unique
  orderId       String
  productId     String?
  productEan    String?
  customerLogin String
  customerEmail String?
  reason        String?  @db.Text
  tags          String[] @default([])
  status        String   @default("NEW")
  refundAmount  Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customerProfile CustomerRiskProfile? @relation(fields: [customerLogin], references: [allegroLogin])

  @@index([customerLogin])
  @@index([productId])
}
